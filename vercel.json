{
  "version": 2,
  "name": "oban-wears",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, X-Admin-Email, X-Admin-Password"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cpanel",
      "destination": "https://obanwears.com:2083",
      "permanent": false
    },
    {
      "source": "/webmail",
      "destination": "https://obanwears.com:2096",
      "permanent": false
    },
    {
      "source": "/whm",
      "destination": "https://obanwears.com:2087",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/admin.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "dashboard.obanwears.com"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.dashboard.obanwears.com"
        }
      ],
      "destination": "/admin.html"
    }
  ]
}