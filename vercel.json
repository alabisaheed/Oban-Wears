{
  "version": 2,
  "name": "oban-wears",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, X-Admin-Email, X-Admin-Password"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cpanel",
      "destination": "https://mail.obanwears.com:2083",
      "permanent": false
    },
    {
      "source": "/webmail",
      "destination": "https://mail.obanwears.com:2096",
      "permanent": false
    },
    {
      "source": "/whm",
      "destination": "https://mail.obanwears.com:2087",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/admin.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/obpk",
      "destination": "https://mail.obanwears.com/obpk/"
    },
    {
      "source": "/obku",
      "destination": "https://mail.obanwears.com/obku/"
    },
    {
      "source": "/obtu",
      "destination": "https://mail.obanwears.com/obtu/"
    },
    {
      "source": "/wp-content/:path*",
      "destination": "https://mail.obanwears.com/wp-content/:path*"
    },
    {
      "source": "/wp-includes/:path*",
      "destination": "https://mail.obanwears.com/wp-includes/:path*"
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "https://mail.obanwears.com/wp-admin/:path*"
    },
    {
      "source": "/wp-json/:path*",
      "destination": "https://mail.obanwears.com/wp-json/:path*"
    },
    {
      "source": "/wp-login.php",
      "destination": "https://mail.obanwears.com/wp-login.php"
    },
    {
      "source": "/wp-cron.php",
      "destination": "https://mail.obanwears.com/wp-cron.php"
    },
    {
      "source": "/xmlrpc.php",
      "destination": "https://mail.obanwears.com/xmlrpc.php"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "dashboard.obanwears.com"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.dashboard.obanwears.com"
        }
      ],
      "destination": "/admin.html"
    }
  ]
}
