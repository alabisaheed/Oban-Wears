# Settings for the /api functions. Set these in Vercel (Project → Settings →
# Environment Variables). For local scripts, `npx vercel env pull .env.local`
# copies them into .env.local. Never commit real values.

# Added automatically when a Neon Postgres database is connected to the
# project (Vercel → Storage → Create Database → Neon). Leave empty locally to
# use the local .data/dev-db.json file instead.
DATABASE_URL=

# Signs login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Owner logins for the dashboard (comma separated) and their password.
# Other staff are added from the Staff tab and set their own passwords.
ADMIN_EMAILS=
ADMIN_PASSWORD=
ADMIN_NAME=

# Sign-in codes are emailed after the password. Configure ONE way to send email:
# a mailbox (e.g. noreply@obanwears.com created in cPanel)...
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# ...or a Resend API key (https://resend.com).
RESEND_API_KEY=
MAIL_FROM=Oban Wears <noreply@obanwears.com>

# Emergency only: LOGIN_OTP=off skips the emailed code step.
LOGIN_OTP=
